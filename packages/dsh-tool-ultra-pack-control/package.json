{
  "name": "@lvy-jsd/dsh-tool-ultra-pack-control",
  "version": "0.5.0",
  "description": "SSH, Android adb and remote Linux desktop control for Tool Ultra: configured aliases, session discovery and call approval. No npm dependencies.",
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "!lib/.tsbuildinfo",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b .",
    "prepack": "tsc -b ."
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-tool-ultra",
    "tools",
    "ssh",
    "remote",
    "adb",
    "android",
    "kernelsu",
    "desktop",
    "wayland",
    "x11"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "toolCatalog": {
      "tools": {
        "ssh_hosts": { "group": "ssh", "category": "system", "risk": "low" },
        "ssh_sys": { "group": "ssh", "category": "system", "risk": "low" },
        "ssh_read": { "group": "ssh", "category": "system", "risk": "low" },
        "ssh_log": { "group": "ssh", "category": "system", "risk": "low" },
        "ssh_run": { "group": "ssh", "category": "system", "risk": "high" },
        "ssh_write": { "group": "ssh", "category": "system", "risk": "high" },
        "ssh_get": { "group": "ssh", "category": "system", "risk": "medium" },
        "ssh_put": { "group": "ssh", "category": "system", "risk": "high" },
        "adb_devices": { "group": "adb", "category": "device", "risk": "low" },
        "adb_info": { "group": "adb", "category": "device", "risk": "low" },
        "adb_screen": { "group": "adb", "category": "device", "risk": "low" },
        "adb_ui": { "group": "adb", "category": "device", "risk": "low" },
        "adb_tap": { "group": "adb", "category": "device", "risk": "medium" },
        "adb_input": { "group": "adb", "category": "device", "risk": "medium" },
        "adb_app": { "group": "adb", "category": "device", "risk": "medium" },
        "adb_logcat": { "group": "adb", "category": "device", "risk": "low" },
        "adb_shell": { "group": "adb-root", "category": "device", "risk": "high" },
        "adb_push": { "group": "adb-root", "category": "device", "risk": "high" },
        "adb_pull": { "group": "adb-root", "category": "device", "risk": "high" },
        "adb_install": { "group": "adb-root", "category": "device", "risk": "high" },
        "desktop_screen": { "group": "desktop", "category": "device", "risk": "low" },
        "desktop_windows": { "group": "desktop", "category": "device", "risk": "low" },
        "desktop_focus": { "group": "desktop", "category": "device", "risk": "medium" },
        "desktop_click": { "group": "desktop", "category": "device", "risk": "medium" },
        "desktop_type": { "group": "desktop", "category": "device", "risk": "medium" },
        "desktop_key": { "group": "desktop", "category": "device", "risk": "medium" },
        "desktop_clipboard_get": { "group": "desktop", "category": "device", "risk": "low" },
        "desktop_clipboard_set": { "group": "desktop", "category": "device", "risk": "medium" }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvy-jsd/dsh-tool-ultra.git",
    "directory": "packages/dsh-tool-ultra-pack-control"
  }
}
