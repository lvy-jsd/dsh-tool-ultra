{
  "name": "dsh-tool-ultra-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "author": "lvy-jsd",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/link-host.mjs",
    "prepare": "npm run build",
    "generate:ts-projects": "node scripts/generate-ts-projects.mjs",
    "build": "node scripts/generate-ts-projects.mjs && tsc -b",
    "typecheck": "node scripts/generate-ts-projects.mjs && tsc -b",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck",
    "test": "npm run build && node --test test/unit/*.test.mjs && node test/e2e.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "eslint": "^9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "mathjs": "15.2.0"
  }
}
